# PostgreSQL
POSTGRES_DB="vizitum"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vizitum"

# Redis / BullMQ. Also backs the auth rate-limit counters, which fall back to
# per-process memory when unset — fine locally, refused in production.
REDIS_URL="redis://localhost:6379"

# Number of proxies between the client and this API. Required in production;
# getting it wrong either puts all traffic in one rate-limit bucket (too low)
# or lets clients forge their own address (too high). 0 for a local dev
# server; for browser -> edge -> Next -> edge -> API the API sees 2.
TRUST_PROXY_HOPS="0"

# Turns off every auth rate limit and the per-account backoff. Only the
# Playwright suite sets it; production refuses to start with it enabled.
RATE_LIMIT_DISABLED=""

# Sessions
SESSION_SECRET="replace-with-a-long-random-secret"
# Encrypts the platform owner's TOTP secret at rest (AES-256-GCM). 32 bytes,
# base64 or hex: `openssl rand -base64 32`. Required in production; without it
# secrets are stored in the clear, which is what the production gate refuses.
# Losing this key means the owner must re-enrol with a recovery code.
TOTP_ENCRYPTION_KEY=""
SESSION_COOKIE_NAME="vizitum_session"

# OpenAI
OPENAI_API_KEY="sk-replace-me"

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="vizitum"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_FORCE_PATH_STYLE="true"

# Application URLs
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"

# Header the web layer reads the client's address from before forwarding it to
# the API, which is what every per-IP rate limit ends up keyed on. Required in
# production (the web process refuses to start without it). Must be a header
# the host WRITES and refuses to take from the client: "x-vercel-forwarded-for"
# on Vercel, where apps/web is deployed; "cf-connecting-ip" only where
# Cloudflare's proxy actually terminates the request (it does not for
# www.vizitum.com, which is DNS-only on Cloudflare and served by Vercel
# directly — setting it there would forward no address at all). Not
# "x-forwarded-for": whether it can be forged depends on the host, and
# Cloudflare appends to it rather than replacing it. Unset locally, and not
# required on Vercel previews either (they run as production but serve no real
# traffic, so the gate checks VERCEL_ENV as well).
CLIENT_IP_HEADER=""

# Invite email (src/modules/email): off (default), console (dev-only), resend
EMAIL_PROVIDER="off"
EMAIL_FROM="Vizitum <no-reply@example.com>"
RESEND_API_KEY=""

# Cloudflare Turnstile login captcha: both unset (default) disables it.
# Secret is read by the API, site key by the web app; set them together.
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# Platform operations endpoint check
PLATFORM_OPERATIONS_TOKEN_SHA256=""
PLATFORM_OPERATIONS_TOKEN=""

# Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
