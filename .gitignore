.DS_Store

# Dependencies
node_modules/

# Environment
.env
.env.*
!.env.example

# Prisma/local generated artifacts
*.db
*.db-journal

# Build outputs
dist/
build/
.next/
coverage/
*.tsbuildinfo

# Next.js rewrites this file on every dev/build/typegen run, pointing it at the
# dist dir of whichever command ran: `next dev` writes .next/dev/types/*, `next
# build` writes .next/types/*. Tracking it therefore left the tree dirty after
# whichever of the two ran last. Next's own docs say to ignore it; nothing needs
# it committed, since `npm run web:typecheck` regenerates it via `next typegen`.
apps/web/next-env.d.ts

# Playwright artifacts
test-results/
playwright-report/
blob-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
