{
  "name": "vizitum",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "sh scripts/db-down.sh",
    "db:logs": "sh scripts/db-logs.sh",
    "dev:bootstrap": "npm run db:up && npm run prisma:migrate:deploy && npm run seed:platform-owner",
    "dev": "node --watch --require ts-node/register src/main.ts",
    "format": "prettier --write \"src/**/*.ts\" \"apps/web/**/*.{ts,tsx,css,json}\" prisma.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"apps/web/**/*.{ts,tsx,css,json}\" prisma.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json",
    "lint": "eslint src apps/web prisma.config.ts",
    "prebuild": "npm run prisma:generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "alerts:check": "node scripts/production-alerts-check.mjs",
    "restore:drill:check": "sh scripts/restore-drill-check.sh",
    "seed:demo-roles": "node scripts/seed-demo-roles.mjs",
    "seed:staging-admin": "node scripts/seed-staging-admin.mjs",
    "seed:platform-owner": "node scripts/seed-platform-owner.mjs",
    "backfill:phone-e164": "node scripts/backfill-phone-e164.mjs",
    "start": "node dist/main.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "worker:cleanup": "WORKER_TASK=cleanup node --require ts-node/register src/worker.ts",
    "worker:cleanup:prod": "WORKER_TASK=cleanup node dist/worker.js",
    "worker:purge": "WORKER_TASK=purge node --require ts-node/register src/worker.ts",
    "worker:purge:prod": "WORKER_TASK=purge node dist/worker.js",
    "web:build": "npm run build --workspace @vizitum/web",
    "web:dev": "npm run dev --workspace @vizitum/web",
    "web:start": "npm run start --workspace @vizitum/web",
    "web:typecheck": "npm run typecheck --workspace @vizitum/web",
    "web:e2e": "npm run e2e --workspace @vizitum/web",
    "web:i18n:check": "node scripts/check-web-i18n-literals.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IhorKiy/VIZITUM.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/IhorKiy/VIZITUM/issues"
  },
  "homepage": "https://github.com/IhorKiy/VIZITUM#readme",
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.9",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.1",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@prisma/engines@7.8.0": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "@swc/core@1.15.43": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true
  }
}
