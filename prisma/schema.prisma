generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// `pilot`/`team`/`business` double as both the tenant's lifecycle state and its
// plan tier (see PlatformTenant.status) — there is no separate plan field.
// `draft`/`provisioning`/`ready`/`active` are retired (kept only so historical
// rows/events referencing them remain valid); nothing assigns them anymore.
enum TenantStatus {
  draft
  provisioning
  ready
  pilot
  team
  business
  active
  suspended
  archived
}

enum ProductMode {
  team
  business
}

enum DatabasePlacement {
  shared
  dedicated
}

enum SegmentTemplate {
  distribution
  service
  partner_account
  medical
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum PlatformUserStatus {
  active
  suspended
}

enum UserStatus {
  invited
  active
  suspended
  deleted
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

// Delivery outcome of the invite email. `skipped` means sending was never
// attempted (email disabled or tenant row missing), `failed` means an attempt
// errored — in both cases the invite itself is valid and the accept link shown
// in the UI remains the manual fallback channel.
enum InviteEmailStatus {
  skipped
  sent
  failed
}

enum RoleCode {
  tenant_superadmin
  company_admin
  team_manager
  field_representative
}

// Frontend navigation grouping, not a permission model — see
// apps/web/lib/navigation.ts and src/modules/auth/zones.ts.
enum NavZone {
  field
  manager
  admin
  operations
}

enum LocationStatus {
  active
  inactive
  archived
}

enum ChainStatus {
  active
  archived
}

enum AssignmentStatus {
  active
  inactive
}

enum ProductStatus {
  active
  inactive
  archived
}

enum AssortmentStatus {
  in_stock
  out_of_stock
}

enum RouteStatus {
  draft
  published
  in_progress
  completed
  cancelled
}

enum RouteItemStatus {
  planned
  visited
  skipped
}

enum VisitStatus {
  draft
  in_progress
  completed
  cancelled
}

enum VisitCancellationReason {
  location_closed
  client_unavailable
  route_changed
  other
}

enum VisitNoteInputType {
  text
  audio
}

enum ReportStatus {
  draft
  confirmed
  discarded
}

enum TaskStatus {
  in_progress
  done
}

enum ImportType {
  users
  locations
  contacts
  products
  initial_visit_task_plan
}

enum ImportStatus {
  uploaded
  validated
  validation_failed
  confirmed
  applied
  failed
  cancelled
}

enum ImportIssueSeverity {
  error
  warning
}

enum AiJobType {
  transcription
  extraction
}

enum AiJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum StorageObjectStatus {
  active
  deleted
  expired
}

enum StorageObjectPurpose {
  temporary_audio
  temporary_transcript
  import_file
  export_file
  attachment
  branding_logo
  // Evidence attached to one visit's report (currently the problem photo).
  // Distinct from the generic `attachment` on purpose: storage permissions
  // and cleanup treat it as a visit artifact, and a future non-visit
  // attachment must not inherit those rules by sharing a name.
  visit_attachment
}

model PlatformTenant {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  country           String
  timezone          String
  language          String
  // ISO 3166-1 alpha-2 default country for phone number entry, set by the
  // platform owner. Null (legacy tenants) means "no default": only
  // "+"-prefixed international phone input is accepted for that tenant.
  phoneCountry      String?
  // Primary contact for the tenant, captured at creation by the platform owner.
  // Nullable because tenants created before this was added have no contact on
  // file; the create flow requires all three for new tenants.
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  status            TenantStatus      @default(pilot)
  productMode       ProductMode       @default(team)
  segmentTemplate   SegmentTemplate
  databasePlacement DatabasePlacement @default(shared)
  databaseKey       String
  primaryDomain     String?
  // Optional platform-owner override for the Company Admin cap. NULL means the
  // cap derives from the plan tier (`status`): pilot 0, team 1, business 2 (see
  // adminCapForStatus in src/modules/users/users.types.ts). A number is an
  // explicit per-tenant exception the owner sets deliberately.
  adminLimit        Int?
  archivedAt        DateTime?
  // Two-stage deletion markers. `purgeRequestedAt` is the platform owner's
  // explicit early-purge mark (set only on archived tenants; cleared by
  // unarchive). `purgeStartedAt` is the point of no return: the purge worker
  // stamps it before deleting anything, and unarchive refuses once it is set,
  // so a partially-purged tenant can never come back half-visible.
  purgeRequestedAt  DateTime?
  purgeStartedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  provisioningJobs PlatformProvisioningJob[]
  operationEvents  PlatformOperationEvent[]

  @@index([status])
  @@index([databasePlacement])
  @@index([segmentTemplate])
  @@map("platform_tenants")
}

model PlatformUser {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  status       PlatformUserStatus @default(active)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  sessions PlatformSession[]

  @@map("platform_users")
}

model PlatformSession {
  id               String    @id @default(cuid())
  platformUserId   String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime?
  userAgentHash    String?
  ipHash           String?

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

model PlatformProvisioningJob {
  id           String    @id @default(cuid())
  tenantId     String
  status       JobStatus @default(queued)
  step         String?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant PlatformTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("platform_provisioning_jobs")
}

model PlatformOperationEvent {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  eventType   String
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())

  tenant PlatformTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([eventType])
  @@map("platform_operation_events")
}

model User {
  id                   String     @id @default(cuid())
  tenantId             String
  email                String
  // Given name and family name are the source of truth. `lastName` is nullable
  // because the backfill splits legacy single-string names on the first space
  // and a one-word name leaves nothing to put here — new writes always supply
  // both. `name` is a derived display value, composed by
  // `composeUserDisplayName` and never written on its own; it stays so the many
  // read sites that only ever show a full name keep working unchanged.
  firstName            String
  lastName             String?
  name                 String
  phone                String?
  status               UserStatus @default(invited)
  passwordHash         String?
  lastLoginAt          DateTime?
  lastSelectedRoleCode RoleCode?
  lastSelectedZone     NavZone?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  roles                      UserRole[]                @relation("UserRoles")
  assignedRoles              UserRole[]                @relation("AssignedUserRoles")
  createdInvites             Invite[]                  @relation("CreatedInvites")
  acceptedInvites            Invite[]                  @relation("AcceptedInvites")
  sessions                   Session[]
  updatedSettings            TenantSetting[]           @relation("UpdatedTenantSettings")
  createdLocationAssignments LocationAssignment[]      @relation("CreatedLocationAssignments")
  assignedLocations          LocationAssignment[]      @relation("RepresentativeLocationAssignments")
  routePlans                 RoutePlan[]               @relation("RepresentativeRoutePlans")
  createdRoutePlans          RoutePlan[]               @relation("CreatedRoutePlans")
  routeTemplates             RouteTemplate[]           @relation("RepresentativeRouteTemplates")
  visits                     Visit[]                   @relation("RepresentativeVisits")
  visitNotes                 VisitNote[]               @relation("CreatedVisitNotes")
  confirmedReports           Report[]                  @relation("ConfirmedReports")
  reports                    Report[]                  @relation("RepresentativeReports")
  assignedTasks              Task[]                    @relation("AssignedTasks")
  createdTasks               Task[]                    @relation("CreatedTasks")
  changedTaskStatusHistory   TaskStatusHistory[]       @relation("ChangedTaskStatusHistory")
  uploadedImports            ImportJob[]               @relation("UploadedImports")
  confirmedImports           ImportJob[]               @relation("ConfirmedImports")
  createdStorageObjects      StorageObject[]           @relation("CreatedStorageObjects")
  auditEvents                AuditEvent[]              @relation("ActorAuditEvents")
  createdAnnouncements       Announcement[]            @relation("CreatedAnnouncements")
  announcementReads          AnnouncementReadReceipt[] @relation("AnnouncementReads")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, lastLoginAt])
  @@map("users")
}

model UserRole {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  roleCode         RoleCode
  assignedByUserId String?
  createdAt        DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedUserRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, roleCode])
  @@index([tenantId, roleCode])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model Invite {
  id               String            @id @default(cuid())
  tenantId         String
  email            String
  roleCodes        RoleCode[]
  tokenHash        String            @unique
  status           InviteStatus      @default(pending)
  emailStatus      InviteEmailStatus @default(skipped)
  emailSentAt      DateTime?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  acceptedBy User? @relation("AcceptedInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("CreatedInvites", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("invites")
}

model Session {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime?
  userAgentHash    String?
  ipHash           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

model TenantSetting {
  id              String   @id @default(cuid())
  tenantId        String
  key             String
  value           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("UpdatedTenantSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model ProductCapability {
  id             String   @id @default(cuid())
  tenantId       String
  capabilityCode String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, capabilityCode])
  @@map("product_capabilities")
}

model Chain {
  id           String      @id @default(cuid())
  tenantId     String
  externalCode String?
  name         String
  status       ChainStatus @default(active)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  locations Location[]

  @@unique([tenantId, externalCode])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("chains")
}

model Location {
  id           String         @id @default(cuid())
  tenantId     String
  chainId      String?
  categoryId   String?
  externalCode String?
  name         String
  status       LocationStatus @default(active)
  addressLine  String
  city         String
  // `region` and `territory` are dormant/reserved for the Business tier
  // (regional/territory breakdown). Not exposed in the UI, API or CSV import
  // today — removed from the Pilot/Team surface — but kept in the schema (and
  // indexed) so existing data survives until the Business package
  // re-introduces a plan-gated, territory-aware surface.
  region       String?
  territory    String?
  latitude     Decimal?       @db.Decimal(10, 7)
  longitude    Decimal?       @db.Decimal(10, 7)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  chain              Chain?               @relation(fields: [chainId], references: [id], onDelete: SetNull)
  category           LocationCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contacts           LocationContact[]
  assignments        LocationAssignment[]
  routeItems         RouteItem[]
  routeTemplateItems RouteTemplateItem[]
  visits             Visit[]
  reports            Report[]
  tasks              Task[]
  potentials         LocationPotential[]
  assortmentEntries  LocationAssortment[]

  // Uniqueness on (tenantId, externalCode) is enforced by a PARTIAL unique index
  // scoped to `deletedAt IS NULL` (see the
  // `20260718090000_location_external_code_partial_unique` migration). Prisma
  // can't express partial unique indexes in the schema, so it is managed via raw
  // SQL and intentionally omitted here — do NOT reintroduce a plain
  // `@@unique([tenantId, externalCode])`, which would reserve externalCodes of
  // archived (soft-deleted) locations and break re-create/re-import after
  // archive. Because the index is invisible to Prisma's diff, a later
  // `migrate dev` may auto-generate a `DROP INDEX` for it — keep it in the
  // generated migration. tests/location-external-code-index.test.ts guards
  // against both mistakes.
  @@index([tenantId, status])
  @@index([tenantId, city])
  @@index([tenantId, region])
  @@index([tenantId, territory])
  @@index([tenantId, chainId])
  @@index([tenantId, categoryId])
  @@map("locations")
}

model LocationContact {
  id         String    @id @default(cuid())
  tenantId   String
  locationId String
  name       String
  roleTitle  String?
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId])
  @@map("location_contacts")
}

model LocationCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]

  // Uniqueness on (tenantId, name) is enforced CASE-INSENSITIVELY by a functional
  // unique index on (tenantId, lower(name)) (see the
  // `20260718100000_location_category_dictionary` migration). Prisma can't
  // express functional indexes in the schema, so it is managed via raw SQL and
  // intentionally omitted here — do NOT reintroduce a plain
  // `@@unique([tenantId, name])`, which would only guard exact case and let
  // "Bakery" and "bakery" coexist again.
  @@index([tenantId])
  @@map("location_categories")
}

model LocationAssignment {
  id                   String           @id @default(cuid())
  tenantId             String
  locationId           String
  representativeUserId String
  status               AssignmentStatus @default(active)
  assignedByUserId     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  representative User     @relation("RepresentativeLocationAssignments", fields: [representativeUserId], references: [id], onDelete: Cascade)
  assignedBy     User?    @relation("CreatedLocationAssignments", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, locationId, representativeUserId])
  @@index([tenantId, representativeUserId, status])
  @@index([tenantId, locationId, status])
  @@map("location_assignments")
}

model Product {
  id            String        @id @default(cuid())
  tenantId      String
  externalCode  String?
  name          String
  sku           String?
  category      String?
  status        ProductStatus @default(active)
  notApplicable Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  assortmentEntries LocationAssortment[]

  // Uniqueness on (tenantId, externalCode) is enforced by a PARTIAL unique index
  // scoped to `deletedAt IS NULL` (see the
  // `20260713120000_product_external_code_partial_unique` migration). Prisma
  // can't express partial unique indexes in the schema, so it is managed via raw
  // SQL and intentionally omitted here — do NOT reintroduce a plain
  // `@@unique([tenantId, externalCode])`, which would reserve externalCodes of
  // soft-deleted products and break re-import after delete. Because the index is
  // invisible to Prisma's diff, a later `migrate dev` may auto-generate a
  // `DROP INDEX` for it — keep it in the generated migration. tests/
  // product-external-code-index.test.ts guards against both mistakes.
  @@index([tenantId, status])
  @@map("products")
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationPotentials LocationPotential[]

  // Uniqueness on (tenantId, name) is enforced CASE-INSENSITIVELY by a functional
  // unique index on (tenantId, lower(name)) (see the
  // `20260713000000_product_category_case_insensitive_name` migration). Prisma
  // can't express functional indexes in the schema, so it is managed via raw SQL
  // and intentionally omitted here — do NOT reintroduce a plain
  // `@@unique([tenantId, name])`, which would only guard exact case and let
  // "Beverages" + "beverages" coexist again.
  @@index([tenantId])
  @@map("product_categories")
}

// One row per (location, product category): the rep/admin's estimate of sales
// potential at that location for that category, plus a 3-month plan. Hard
// rows, no soft delete — this is an attribute table like LocationAssignment,
// not a document.
model LocationPotential {
  id                String    @id @default(cuid())
  tenantId          String
  locationId        String
  productCategoryId String
  potentialDate     DateTime? @db.Date
  potentialAmount   Int?
  planMonth1        Int?
  planMonth2        Int?
  planMonth3        Int?
  comment           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productCategory ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, locationId, productCategoryId])
  @@map("location_potentials")
}

// One row per (location, product) with two distinct owners. The manager owns
// `shouldBeListed` — the matrix: what this outlet is supposed to carry. The
// field owns `status` and `lastCheckedAt` — what was actually on the shelf,
// observed during a visit. A null status means "in the matrix, never yet
// confirmed on the shelf", which is why the column has no default: a matrix a
// manager just typed in must not read as fully covered before anyone has
// walked into the store. Coverage is computed purely from these rows
// (shouldBeListed + status) — Product.category is free text, never joined for
// this purpose. Hard rows, no soft delete.
model LocationAssortment {
  id             String            @id @default(cuid())
  tenantId       String
  locationId     String
  productId      String
  shouldBeListed Boolean           @default(true)
  status         AssortmentStatus?
  lastCheckedAt  DateTime?         @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, productId])
  @@index([tenantId, productId, status])
  @@map("location_assortment")
}

model RoutePlan {
  id                   String      @id @default(cuid())
  tenantId             String
  representativeUserId String
  planDate             DateTime    @db.Date
  status               RouteStatus @default(draft)
  createdByUserId      String?
  routeTemplateId      String?
  publishedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  representative User           @relation("RepresentativeRoutePlans", fields: [representativeUserId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation("CreatedRoutePlans", fields: [createdByUserId], references: [id], onDelete: SetNull)
  routeTemplate  RouteTemplate? @relation(fields: [routeTemplateId], references: [id], onDelete: SetNull)
  items          RouteItem[]

  // Uniqueness on (tenantId, representativeUserId, planDate) is enforced by
  // TWO partial unique indexes (see the
  // `20260721062916_route_plan_multi_per_day` migration), not a plain
  // `@@unique`: one scoped to `routeTemplateId IS NOT NULL` (a representative
  // can hold several template-based plans on the same day, but not the same
  // template twice) and one scoped to `routeTemplateId IS NULL` (still at
  // most one template-less manual plan per day, matching
  // RoutesService.createRoutePlan's get-or-create behavior). Prisma can't
  // express partial unique indexes in schema.prisma, so both are managed via
  // raw SQL and intentionally omitted here — do NOT reintroduce a plain
  // `@@unique([tenantId, representativeUserId, planDate])`, which would block
  // assigning more than one route template per day again. Because the index
  // is invisible to Prisma's diff, a later `migrate dev` may auto-generate a
  // `DROP INDEX` for it — keep it in the generated migration.
  // tests/route-plan-multi-per-day-index.test.ts guards against both
  // mistakes.
  @@index([tenantId, planDate])
  @@index([tenantId, representativeUserId, planDate])
  @@index([tenantId, routeTemplateId])
  @@map("route_plans")
}

model RouteItem {
  id               String          @id @default(cuid())
  tenantId         String
  routePlanId      String
  locationId       String
  sequence         Int
  status           RouteItemStatus @default(planned)
  plannedStartTime DateTime?
  plannedEndTime   DateTime?
  skipReason       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  routePlan RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  visit     Visit?

  @@unique([tenantId, routePlanId, sequence])
  @@index([tenantId, routePlanId])
  @@index([tenantId, locationId])
  @@map("route_items")
}

// A representative's reusable, named stop list. Assigning a template to a
// date materializes a RoutePlan + RouteItems (see RoutePlan.routeTemplateId)
// — the template itself never drives visits/reports directly.
model RouteTemplate {
  id                   String   @id @default(cuid())
  tenantId             String
  representativeUserId String
  name                 String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  representative User                @relation("RepresentativeRouteTemplates", fields: [representativeUserId], references: [id], onDelete: Cascade)
  items          RouteTemplateItem[]
  routePlans     RoutePlan[]

  @@index([tenantId, representativeUserId])
  @@map("route_templates")
}

model RouteTemplateItem {
  id              String   @id @default(cuid())
  tenantId        String
  routeTemplateId String
  locationId      String
  sequence        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routeTemplate RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, routeTemplateId, sequence])
  @@index([tenantId, routeTemplateId])
  @@index([tenantId, locationId])
  @@map("route_template_items")
}

model Visit {
  id                   String                   @id @default(cuid())
  tenantId             String
  locationId           String
  representativeUserId String
  routeItemId          String?
  visitType            String
  status               VisitStatus              @default(draft)
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   VisitCancellationReason?
  cancellationComment  String?
  /// Identifier the device minted when the rep started this visit, which they can
  /// do with no signal at all. It is the idempotency key for the deferred create
  /// — the phone cannot tell a request that was lost from one whose answer was —
  /// and it is also how a locally-started visit keeps a stable URL: the visit
  /// screen resolves either this or the server's own id.
  ///
  /// Deliberately NOT the primary key. The server keeps minting its own cuid, so
  /// nothing about row identity moves into client hands; this is a correlation
  /// key beside it. Null for every visit started before this existed and for any
  /// caller that does not send one.
  ///
  /// Written when this row is *created*, and never after. A deferred start that
  /// finds the stop's slot already held by the rep's own open visit adopts that
  /// visit rather than creating one, and the id it minted is recorded in
  /// `VisitClientAlias` instead — one column cannot hold the several client ids
  /// that can legitimately resolve to one adopted visit.
  clientVisitId        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  location       Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  representative User               @relation("RepresentativeVisits", fields: [representativeUserId], references: [id], onDelete: Restrict)
  routeItem      RouteItem?         @relation(fields: [routeItemId], references: [id], onDelete: SetNull)
  notes          VisitNote[]
  report         Report?
  tasks          Task[]
  aiJobs         AiJob[]
  clientAliases  VisitClientAlias[]

  @@unique([routeItemId])
  @@unique([tenantId, clientVisitId])
  // Placing a visit in time means COALESCE(startedAt, createdAt), and that
  // reaches the database in two different shapes. The *day summary* sends the
  // COALESCE literally, which only an expression index can serve — those two
  // ("visits_tenant_representative_period_idx", "visits_tenant_period_idx")
  // live in prisma/migrations/20260728120000_visit_period_indexes, since
  // Prisma's schema language cannot express an index on an expression. Its
  // history-boundary query (MIN over the same expression, scoped but unbounded
  // in time) needs the same expression with `status` folded in when a status
  // filter is on — two more hand-written indexes, in
  // prisma/migrations/20260728160000_visit_history_start_indexes; they extend
  // rather than replace the pair above, since `status` sits between the scope
  // columns and the timestamp. The
  // *list* (findMany/count/groupBy) goes through the ORM, which expands the
  // same intent into `startedAt >= x OR (startedAt IS NULL AND createdAt >= x)`
  // — a plain bitmap OR that the expression indexes cannot serve at all. The
  // four indexes below are the ones that do: one pair per branch of that OR,
  // once scoped to a representative (field history) and once tenant-wide
  // (manager visits, which had no usable index and sequentially scanned).
  // The createdAt pairs double as the ORDER BY createdAt DESC support.
  @@index([tenantId, representativeUserId, startedAt])
  @@index([tenantId, representativeUserId, createdAt])
  @@index([tenantId, startedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, locationId, startedAt])
  @@index([tenantId, routeItemId])
  @@index([tenantId, status])
  @@index([tenantId, completedAt])
  @@map("visits")
}

/// A client-minted id that resolves to a visit it did not create.
///
/// `Visit.clientVisitId` covers the ordinary deferred start, where the id the
/// phone minted becomes the id of the row the server creates. It cannot cover
/// the adopt outcome: a stop has exactly one visit slot, so a start arriving to
/// find the rep's own visit already open there is handed that visit instead —
/// and two devices, or two retries whose responses were both lost, can arrive
/// at the same open visit with two different minted ids. A single column takes
/// only the first, and the second is then unrecoverable: its retry finds
/// nothing to replay onto, re-derives the slot from scratch, and — if the
/// adopted visit has closed by then — mints a second, unwanted, unlinked visit
/// for a stop that was already done.
///
/// So every adopt records its id here instead, and the two lookups are tried in
/// a fixed order (server id, then `Visit.clientVisitId`, then this) so a real id
/// always wins over client input claiming to be one. Rows are only ever added,
/// never rewritten: a client id maps to one visit for good.
model VisitClientAlias {
  id            String   @id @default(cuid())
  tenantId      String
  visitId       String
  clientVisitId String
  createdAt     DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientVisitId])
  @@index([visitId])
  @@map("visit_client_aliases")
}

model VisitNote {
  id                     String             @id @default(cuid())
  tenantId               String
  visitId                String
  inputType              VisitNoteInputType
  textContent            String?
  temporaryAudioObjectId String?
  createdByUserId        String
  createdAt              DateTime           @default(now())
  deletedAt              DateTime?

  visit                Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  temporaryAudioObject StorageObject? @relation("VisitNoteTemporaryAudio", fields: [temporaryAudioObjectId], references: [id], onDelete: SetNull)
  createdBy            User           @relation("CreatedVisitNotes", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, visitId])
  @@index([temporaryAudioObjectId])
  @@map("visit_notes")
}

model Report {
  id                   String          @id @default(cuid())
  tenantId             String
  visitId              String          @unique
  locationId           String
  representativeUserId String
  templateCode         SegmentTemplate
  schemaVersion        String
  status               ReportStatus    @default(confirmed)
  confirmedData        Json
  confirmedByUserId    String
  confirmedAt          DateTime
  aiMetadata           Json?
  /// Idempotency token minted by the device, so a confirm the client could not
  /// hear the answer to can be retried without doing the work twice. Null for
  /// every report confirmed before this existed, and for any caller that does
  /// not send one — which is why the uniqueness is a partial index (Postgres
  /// admits unlimited NULLs, so old rows and non-queued confirms coexist).
  ///
  /// It is an opaque token, never a tenant or user identifier: the tenant still
  /// comes from the request context, and a token from another tenant simply
  /// does not match anything here.
  clientRequestId      String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  visit          Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  representative User     @relation("RepresentativeReports", fields: [representativeUserId], references: [id], onDelete: Restrict)
  confirmedBy    User     @relation("ConfirmedReports", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  tasks          Task[]

  @@unique([tenantId, clientRequestId])
  @@index([tenantId, confirmedAt])
  @@index([tenantId, templateCode])
  @@index([tenantId, representativeUserId, confirmedAt])
  @@index([tenantId, locationId, confirmedAt])
  @@map("reports")
}

model Task {
  id               String     @id @default(cuid())
  tenantId         String
  title            String
  description      String?
  status           TaskStatus @default(in_progress)
  isPriority       Boolean    @default(false)
  assignedToUserId String?
  createdByUserId  String?
  locationId       String?
  visitId          String?
  reportId         String?
  dueDate          DateTime?  @db.Date
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  assignedTo    User?               @relation("AssignedTasks", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("CreatedTasks", fields: [createdByUserId], references: [id], onDelete: SetNull)
  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  visit         Visit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  report        Report?             @relation(fields: [reportId], references: [id], onDelete: SetNull)
  statusHistory TaskStatusHistory[]

  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, locationId])
  @@index([tenantId, visitId])
  // The done list, in its two scopes: a representative's own finished work and
  // a manager's tenant-wide view. Both filter on status plus a completedAt
  // window and order by completedAt desc, so completedAt trails the equality
  // columns and the range and the sort come off one index.
  @@index([tenantId, assignedToUserId, status, completedAt])
  @@index([tenantId, status, completedAt])
  @@map("tasks")
}

// One row per task-creation and per status change, so the UI can show "who
// created it" and "who marked it done" without reusing AuditEvent (which is
// for admin/platform events, not this kind of per-entity business history).
// `oldStatus` is null for the creation row. Written in the same transaction
// as the write it records (see TasksService), same convention as AuditEvent.
model TaskStatusHistory {
  id              String      @id @default(cuid())
  tenantId        String
  taskId          String
  changedByUserId String?
  oldStatus       TaskStatus?
  newStatus       TaskStatus
  createdAt       DateTime    @default(now())

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User? @relation("ChangedTaskStatusHistory", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, taskId, createdAt])
  @@index([tenantId, changedByUserId, createdAt])
  @@map("task_status_history")
}

// A manager-authored notice shown to every field representative in the tenant
// for as long as its date window is open — a promotion, a price change, a rule
// for the month. There is no recipient table: the audience is "every
// representative", so targeting one would only be a list to keep in sync with
// the roster. `startsAt`/`endsAt` are date-only and inclusive, interpreted in
// the tenant's timezone, which is what makes "until the 31st" mean the whole
// 31st for a rep in the field. Withdrawing early sets `archivedAt` rather than
// deleting: the read receipts below are the record that the team was told, and
// a hard delete would take that with it.
model Announcement {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  body            String
  startsAt        DateTime  @db.Date
  endsAt          DateTime  @db.Date
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy    User?                     @relation("CreatedAnnouncements", fields: [createdByUserId], references: [id], onDelete: SetNull)
  readReceipts AnnouncementReadReceipt[]

  @@index([tenantId, archivedAt, endsAt])
  @@index([tenantId, createdAt])
  @@map("announcements")
}

// One row the first time a representative marks an announcement read; the
// unique constraint is what makes the mark-read endpoint idempotent (a second
// tap keeps the original `readAt` rather than resetting it). Hard rows with no
// soft delete, like LocationAssignment — a receipt withdrawn is a receipt that
// never happened, and the announcement's own Cascade takes them when it goes.
model AnnouncementReadReceipt {
  id             String   @id @default(cuid())
  tenantId       String
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, announcementId, userId])
  @@index([tenantId, userId])
  // The unique constraint above leads with tenantId, so it can't serve a
  // lookup by announcement alone — which is what the manager board's per-row
  // read count and the announcement's own delete cascade both do.
  @@index([announcementId])
  @@map("announcement_read_receipts")
}

model ImportJob {
  id                 String       @id @default(cuid())
  tenantId           String
  type               ImportType
  status             ImportStatus @default(uploaded)
  sourceFileObjectId String?
  sourceFileName     String?
  uploadedByUserId   String
  confirmedByUserId  String?
  rowCount           Int          @default(0)
  validRowCount      Int          @default(0)
  errorRowCount      Int          @default(0)
  warningRowCount    Int          @default(0)
  summary            Json?
  createdAt          DateTime     @default(now())
  validatedAt        DateTime?
  confirmedAt        DateTime?
  appliedAt          DateTime?
  failedAt           DateTime?
  updatedAt          DateTime     @updatedAt

  sourceFile  StorageObject?   @relation("ImportSourceFile", fields: [sourceFileObjectId], references: [id], onDelete: SetNull)
  uploadedBy  User             @relation("UploadedImports", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  confirmedBy User?            @relation("ConfirmedImports", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  issues      ImportRowIssue[]

  @@index([tenantId, type, createdAt])
  @@index([tenantId, status])
  @@map("import_jobs")
}

model ImportRowIssue {
  id          String              @id @default(cuid())
  tenantId    String
  importJobId String
  rowNumber   Int
  fieldName   String?
  severity    ImportIssueSeverity
  code        String
  message     String
  rawValue    String?
  createdAt   DateTime            @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, importJobId])
  @@index([tenantId, importJobId, rowNumber])
  @@map("import_row_issues")
}

model AiJob {
  id                          String      @id @default(cuid())
  tenantId                    String
  visitId                     String
  type                        AiJobType
  status                      AiJobStatus @default(queued)
  provider                    String
  model                       String
  promptVersion               String?
  schemaVersion               String?
  inputObjectId               String?
  temporaryTranscriptObjectId String?
  temporaryDraft              Json?
  draftQuality                Json?
  errorCode                   String?
  errorMessage                String?
  startedAt                   DateTime?
  finishedAt                  DateTime?
  expiresAt                   DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  visit                     Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  inputObject               StorageObject? @relation("AiJobInputObject", fields: [inputObjectId], references: [id], onDelete: SetNull)
  temporaryTranscriptObject StorageObject? @relation("AiJobTemporaryTranscript", fields: [temporaryTranscriptObjectId], references: [id], onDelete: SetNull)

  @@index([tenantId, visitId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("ai_jobs")
}

model StorageObject {
  id              String               @id @default(cuid())
  tenantId        String
  bucket          String
  objectKey       String
  purpose         StorageObjectPurpose
  contentType     String
  sizeBytes       BigInt?
  checksum        String?
  status          StorageObjectStatus  @default(active)
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  deletedAt       DateTime?

  createdBy                   User?       @relation("CreatedStorageObjects", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visitNotesAsTemporaryAudio  VisitNote[] @relation("VisitNoteTemporaryAudio")
  importJobsAsSourceFile      ImportJob[] @relation("ImportSourceFile")
  aiJobsAsInputObject         AiJob[]     @relation("AiJobInputObject")
  aiJobsAsTemporaryTranscript AiJob[]     @relation("AiJobTemporaryTranscript")

  @@unique([bucket, objectKey])
  @@index([tenantId, purpose])
  @@index([tenantId, expiresAt])
  @@index([tenantId, status])
  @@map("storage_objects")
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  eventType   String
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())

  actor User? @relation("ActorAuditEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_events")
}
